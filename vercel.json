{
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api?sf_path=/api/:path*" },
    { "source": "/midia/:path*", "destination": "/api?sf_path=/midia/:path*" },
    { "source": "/", "destination": "/api?sf_path=/" },
    { "source": "/:path*", "destination": "/api?sf_path=/:path*" }
  ],
  "functions": {
    "api/index.py": {
      "maxDuration": 10,
      "memory": 1024,
      "includeFiles": "{socialflow/**,migrations/**,data/**,css/**,js/**,assets/**,*.html}"
    }
  }
}
