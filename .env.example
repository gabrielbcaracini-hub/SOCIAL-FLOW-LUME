# Copie para .env se quiser sobrescrever os padrões locais.
# O arquivo .env não deve ser commitado. Não coloque chave de produção aqui.

SOCIALFLOW_HOST=127.0.0.1
SOCIALFLOW_PORT=8080
SOCIALFLOW_DB=data/socialflow.sqlite

# Senhas usadas apenas na primeira semeadura do ambiente local.
# Se o banco já existir, mudar estes valores não altera usuários já gravados.
SOCIALFLOW_ADMIN_PASSWORD=Lume-Demo-2026
SOCIALFLOW_SELLER_PASSWORD=Lume-Venda-2026
SOCIALFLOW_CONSULTOR_PASSWORD=Lume-Consulta-2026

# Gemini (padrão). A chave fica só no servidor e nunca vai para o navegador.
# Crie em https://aistudio.google.com/apikey e cole abaixo.
SOCIALFLOW_AI_PROVIDER=gemini
SOCIALFLOW_AI_MODEL=gemini-3.8-flash
SOCIALFLOW_AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# SOCIALFLOW_AI_API_KEY=
# Aceita também GEMINI_API_KEY ou GOOGLE_API_KEY.
